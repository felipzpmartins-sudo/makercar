NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://makercar:makercar@localhost:5432/makercar?schema=public

# Use valores aleatórios e diferentes, com ao menos 32 caracteres, em produção.
JWT_ACCESS_SECRET=change-this-to-a-long-random-access-secret
SUPPORT_RESERVATION_PASSWORD=defina-uma-senha-compartilhada-do-suporte
JWT_REFRESH_SECRET=change-this-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Em produção, informe a URL exata do frontend, sem usar *.
CORS_ORIGIN=http://localhost:3000
PHOTO_STORAGE_DIR=./.data/photos
PUBLIC_API_URL=http://localhost:3333

# Avisos de novas solicitações de reserva para aprovação pelo RH.
# Crie uma chave em https://resend.com/api-keys e use um remetente verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
HR_APPROVAL_EMAIL=rh@makergrupo.com.br

# Conta dona do sistema (perfil "Imperador Supremo").
# Controla quem pode zerar KM e excluir historicos.
SUPREME_OWNER_EMAIL=felipzpmartins@gmail.com
FRONTEND_URL=http://localhost:3000

# Usadas somente quando o banco ainda não possui usuários.
INITIAL_CEO_PASSWORD=change-this-ceo-password
INITIAL_ADMIN_PASSWORD=change-this-admin-password
