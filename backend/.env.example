NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://makercar:makercar@localhost:5432/makercar?schema=public

# Use valores aleatórios e diferentes, com ao menos 32 caracteres, em produção.
JWT_ACCESS_SECRET=change-this-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-this-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Em produção, informe a URL exata do frontend, sem usar *.
CORS_ORIGIN=http://localhost:3000
PHOTO_STORAGE_DIR=./.data/photos
PUBLIC_API_URL=http://localhost:3333

# Usadas somente quando o banco ainda não possui usuários.
INITIAL_CEO_PASSWORD=change-this-ceo-password
INITIAL_ADMIN_PASSWORD=change-this-admin-password
