NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://makercar:makercar@localhost:5432/makercar?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
PHOTO_STORAGE_DIR="/data/photos"
PUBLIC_API_URL=""

# Production on Railway:
# - create a persistent Volume mounted at /data on this service
# - keep the same Prisma schema and run `prisma migrate deploy` on startup
