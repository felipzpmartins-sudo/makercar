generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  FINISHED
  CANCELLED
}

enum ReservationOdometerType {
  PICKUP
  RETURN
}

enum CnhStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String
  email              String     @unique
  passwordHash       String     @map("password_hash")
  departmentId       String     @map("department_id") @db.Uuid
  roleId             String     @map("role_id") @db.Uuid
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  cnhNumber          String?    @unique @map("cnh_number")
  cnhExpiresAt       DateTime?  @map("cnh_expires_at")
  cnhPhotoUrl        String?    @map("cnh_photo_url")
  cnhPhotoPublicId   String?    @map("cnh_photo_public_id")
  cnhStatus          CnhStatus? @map("cnh_status")
  cnhReviewedAt      DateTime?  @map("cnh_reviewed_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  department                    Department                  @relation(fields: [departmentId], references: [id])
  role                          Role                        @relation(fields: [roleId], references: [id])
  reservations                  Reservation[]
  reservationLogs               ReservationLog[]
  auditLogs                     AuditLog[]
  odometerRecords               ReservationOdometerRecord[]
  reviewedReservations          Reservation[]               @relation("ReservationReviewer")
  equipmentReservations         EquipmentReservation[]      @relation("EquipmentReservationRequester")
  reviewedEquipmentReservations EquipmentReservation[]      @relation("EquipmentReservationReviewer")
  equipmentReservationLogs      EquipmentReservationLog[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("departments")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users User[]

  @@map("roles")
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  plate        String        @unique
  color        String
  status       VehicleStatus @default(AVAILABLE)
  mileage      Int
  fuelType     String        @map("fuel_type")
  transmission String
  capacity     Int
  imageUrl     String?       @map("image_url")
  supportOnly  Boolean       @default(false) @map("support_only")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  reservations    Reservation[]
  odometerRecords ReservationOdometerRecord[]

  @@map("vehicles")
}

model Reservation {
  id                        String            @id @default(uuid()) @db.Uuid
  vehicleId                 String            @map("vehicle_id") @db.Uuid
  userId                    String            @map("user_id") @db.Uuid
  pickupDate                DateTime          @map("pickup_date")
  returnDate                DateTime          @map("return_date")
  reason                    String
  status                    ReservationStatus @default(PENDING)
  rejectionReason           String?           @map("rejection_reason")
  cancellationRequestedAt   DateTime?         @map("cancellation_requested_at")
  cancellationRequestReason String?           @map("cancellation_request_reason")
  cancellationReason        String?           @map("cancellation_reason")
  reviewedById              String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt                DateTime?         @map("reviewed_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  vehicle         Vehicle                     @relation(fields: [vehicleId], references: [id])
  user            User                        @relation(fields: [userId], references: [id])
  reviewedBy      User?                       @relation("ReservationReviewer", fields: [reviewedById], references: [id])
  logs            ReservationLog[]
  checklist       VehicleChecklist?
  odometerRecords ReservationOdometerRecord[]

  @@index([vehicleId, status])
  @@index([userId, status])
  @@index([cancellationRequestedAt])
  @@map("reservations")
}

model ReservationOdometerRecord {
  id                  String                  @id @default(uuid()) @db.Uuid
  reservationId       String                  @map("reservation_id") @db.Uuid
  type                ReservationOdometerType
  vehicleId           String?                 @map("vehicle_id") @db.Uuid
  mileage             Int
  fuelLevel           String?                 @map("fuel_level")
  vehicleCondition    String?                 @map("vehicle_condition")
  damages             String?
  photoUrl            String?                 @map("photo_url")
  photoPublicId       String?                 @map("photo_public_id")
  notes               String?
  occurredAt          DateTime                @map("occurred_at")
  tookReservedVehicle Boolean?                @map("took_reserved_vehicle")
  createdById         String                  @map("created_by_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@unique([reservationId, type])
  @@index([vehicleId, type])
  @@map("reservation_odometer_records")
}

model ReservationLog {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  action        String
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("reservation_logs")
}

model VehicleChecklist {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @unique @map("reservation_id") @db.Uuid
  fuelLevel     Int      @map("fuel_level")
  tiresOk       Boolean  @map("tires_ok")
  oilOk         Boolean  @map("oil_ok")
  lightsOk      Boolean  @map("lights_ok")
  documentsOk   Boolean  @map("documents_ok")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("vehicle_checklists")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Equipamentos internos
//
// Segundo modulo de reserva do MakerCar. Nasce generico de proposito: hoje sao
// dois robos, mas a mesma estrutura recebe drones, projetores e notebooks sem
// alterar a aplicacao — basta cadastrar categoria e equipamento.
// ============================================================================

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  UNAVAILABLE
}

enum EquipmentReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model EquipmentCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  // Nome do icone lucide usado pelo frontend (ex.: "Bot"). Guardar o nome em
  // vez do SVG mantem o catalogo cadastravel sem tocar no bundle.
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  equipments Equipment[]

  @@map("equipment_categories")
}

model Equipment {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  slug         String          @unique
  description  String?
  categoryId   String          @map("category_id") @db.Uuid
  imageUrl     String?         @map("image_url")
  /// Imagem alternativa usada no hero (angulo diferente do card).
  heroImageUrl String?         @map("hero_image_url")
  status       EquipmentStatus @default(AVAILABLE)
  location     String?
  notes        String?
  usageRules   String?         @map("usage_rules")
  /// Ficha tecnica livre: [{ label, value }]. Evita uma coluna por atributo.
  specs        Json?
  sortOrder    Int             @default(0) @map("sort_order")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  category     EquipmentCategory      @relation(fields: [categoryId], references: [id])
  reservations EquipmentReservation[]

  @@index([categoryId, active])
  @@map("equipments")
}

model EquipmentReservation {
  id            String   @id @default(uuid()) @db.Uuid
  equipmentId   String   @map("equipment_id") @db.Uuid
  /// Responsavel pela solicitacao: o usuario logado que abriu a reserva.
  userId        String   @map("user_id") @db.Uuid
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  /// Quem de fato vai operar o equipamento — pode nao ser o solicitante.
  operatorName  String   @map("operator_name")
  purpose       String
  usageLocation String   @map("usage_location")
  notes         String?

  status             EquipmentReservationStatus @default(PENDING)
  rejectionReason    String?                    @map("rejection_reason")
  cancellationReason String?                    @map("cancellation_reason")

  /// Aceite do termo: guardado junto da reserva porque o texto do termo muda
  /// com o tempo e precisamos saber qual versao a pessoa aceitou.
  termsAcceptedAt DateTime @map("terms_accepted_at")
  termsVersion    String   @map("terms_version")

  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  equipment  Equipment                 @relation(fields: [equipmentId], references: [id])
  user       User                      @relation("EquipmentReservationRequester", fields: [userId], references: [id])
  reviewedBy User?                     @relation("EquipmentReservationReviewer", fields: [reviewedById], references: [id])
  logs       EquipmentReservationLog[]

  @@index([equipmentId, status])
  @@index([userId, status])
  @@index([startDate, endDate])
  @@map("equipment_reservations")
}

model EquipmentReservationLog {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  action        String
  detail        String?
  createdAt     DateTime @default(now()) @map("created_at")

  reservation EquipmentReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id])

  @@index([reservationId])
  @@map("equipment_reservation_logs")
}
